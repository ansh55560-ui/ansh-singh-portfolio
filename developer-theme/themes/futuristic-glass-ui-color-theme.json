    "selection.background": "#29456D",
    "textLink.foreground": "#71E7FF",
    "textLink.activeForeground": "#B0F4FF",
    "textBlockQuote.background": "#111F35",
    "textBlockQuote.border": "#62DBF4",
    "textCodeBlock.background": "#0B1629",
    "textPreformat.foreground": "#9DEBFF",
    "button.background": "#1B87AD",
    "button.foreground": "#F2FCFF",
    "button.hoverBackground": "#279FC8",
    "button.secondaryBackground": "#1B2942",
    "button.secondaryForeground": "#DCE8FF",
    "input.background": "#0B1729",
    "input.foreground": "#E4EEFF",
    "input.border": "#273C5C",
    "input.placeholderForeground": "#7086A7",
    "dropdown.background": "#101E33",
    "dropdown.foreground": "#DCE8FF",
    "dropdown.border": "#2A4164",
    "list.activeSelectionBackground": "#203B5D",
    "list.activeSelectionForeground": "#F1FAFF",
    "list.inactiveSelectionBackground": "#152943",
    "list.hoverBackground": "#172A44",
    "list.focusBackground": "#1A3654",
    "list.highlightForeground": "#8AEAFF",
    "activityBar.background": "#07101F",
    "activityBar.foreground": "#D7E8FF",
    "activityBar.inactiveForeground": "#657B9D",
    "activityBar.activeBorder": "#65E5FF",
    "activityBar.activeBackground": "#12243A",
    "activityBarBadge.background": "#1EA8D4",
    "activityBarBadge.foreground": "#06111E",
    "sideBar.background": "#0A1526",
    "sideBar.foreground": "#C8D8F1",
    "sideBar.border": "#1C2D48",
    "sideBarTitle.foreground": "#E8F4FF",
    "sideBarSectionHeader.background": "#0F1D32",
    "sideBarSectionHeader.foreground": "#A9BEDD",
    "titleBar.activeBackground": "#081321",
    "titleBar.activeForeground": "#EAF5FF",
    "titleBar.inactiveBackground": "#081321",
    "titleBar.inactiveForeground": "#7185A4",
    "titleBar.border": "#1A2C46",
    "menu.background": "#0E1B2E",
    "menu.foreground": "#DCE8FF",
    "menu.selectionBackground": "#1B3B5E",
    "menu.selectionForeground": "#F1FBFF",
    "menu.border": "#2A4161",
    "editorGroupHeader.tabsBackground": "#081321",
    "editorGroupHeader.tabsBorder": "#1B2B44",
    "tab.activeBackground": "#14243A",
    "tab.activeForeground": "#F0F8FF",
    "tab.inactiveBackground": "#0A1525",
    "tab.inactiveForeground": "#8296B4",
    "tab.hoverBackground": "#172B45",
    "tab.border": "#172940",
    "tab.activeBorderTop": "#67E6FF",
    "tab.unfocusedActiveBorderTop": "#2F7F9A",
    "editor.background": "#081321",
    "editor.foreground": "#DCE8FF",
    "editorLineNumber.foreground": "#405675",
    "editorLineNumber.activeForeground": "#9BBDE8",
    "editorCursor.foreground": "#78ECFF",
    "editor.selectionBackground": "#223D61",
    "editor.inactiveSelectionBackground": "#192D48",
    "editor.selectionHighlightBackground": "#2A54754D",
    "editor.wordHighlightBackground": "#2B66804A",
    "editor.wordHighlightStrongBackground": "#2F8A9B55",
    "editor.findMatchBackground": "#725DAA",
    "editor.findMatchHighlightBackground": "#4E4B8A66",
    "editor.lineHighlightBackground": "#102038",
    "editorIndentGuide.background1": "#1B2A41",
    "editorIndentGuide.activeBackground1": "#3D6F89",
    "editorRuler.foreground": "#203651",
    "editorWhitespace.foreground": "#253951",
    "editorBracketMatch.background": "#1B4960",
    "editorBracketMatch.border": "#64DFF7",
    "editorGutter.background": "#081321",
    "editorError.foreground": "#FF6B94",
    "editorWarning.foreground": "#FFCB74",
    "editorInfo.foreground": "#65CFFF",
    "editorHint.foreground": "#7FE1C1",
    "editorWidget.background": "#102039",
    "editorWidget.border": "#2A4567",
    "editorSuggestWidget.background": "#0D1A2D",
    "editorSuggestWidget.border": "#2A4567",
    "editorSuggestWidget.foreground": "#DCE8FF",
    "editorSuggestWidget.highlightForeground": "#83E9FF",
    "editorSuggestWidget.selectedBackground": "#1B3552",
    "editorHoverWidget.background": "#101F35",
    "editorHoverWidget.border": "#2E4B6F",
    "peekView.border": "#57D7F4",
    "peekViewEditor.background": "#0B182B",
    "peekViewResult.background": "#0E1A2D",
    "peekViewResult.selectionBackground": "#1D3B5D",
    "peekViewTitle.background": "#122640",
    "panel.background": "#091524",
    "panel.border": "#1C2F49",
    "panelTitle.activeForeground": "#DFF5FF",
    "panelTitle.inactiveForeground": "#7187A7",
    "panelTitle.activeBorder": "#67DFF8",
    "terminal.background": "#07111F",
    "terminal.foreground": "#D7E7FF",
    "terminal.ansiBlack": "#0A1321",
    "terminal.ansiRed": "#FF6B94",
    "terminal.ansiGreen": "#72E0B4",
    "terminal.ansiYellow": "#F6D37C",
    "terminal.ansiBlue": "#73A9FF",
    "terminal.ansiMagenta": "#CA9BFF",
    "terminal.ansiCyan": "#68E8FF",
    "terminal.ansiWhite": "#DCE8FF",
    "terminal.ansiBrightBlack": "#667C9A",
    "terminal.ansiBrightRed": "#FF91B0",
    "terminal.ansiBrightGreen": "#9AF2CE",
    "terminal.ansiBrightYellow": "#FFE3A3",
    "terminal.ansiBrightBlue": "#9AC3FF",
    "terminal.ansiBrightMagenta": "#DAB7FF",
    "terminal.ansiBrightCyan": "#A0F4FF",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "statusBar.background": "#0C2238",
    "statusBar.foreground": "#D6EEFF",
    "statusBar.border": "#1E4562",
    "statusBar.debuggingBackground": "#4C2B71",
    "statusBar.debuggingForeground": "#F7EFFF",
    "statusBar.noFolderBackground": "#14243A",
    "statusBarItem.hoverBackground": "#1C3B59",
    "statusBarItem.remoteBackground": "#145C78",
    "statusBarItem.remoteForeground": "#E6FAFF",
    "breadcrumb.foreground": "#8AA2C4",
    "breadcrumb.focusForeground": "#D9F6FF",
    "breadcrumb.activeSelectionForeground": "#8CEBFF",
    "minimap.background": "#081321",
    "minimap.selectionHighlight": "#4D8CA9",
    "minimap.findMatchHighlight": "#C8A7FF",
    "scrollbarSlider.background": "#43617A55",
    "scrollbarSlider.hoverBackground": "#5B8BAB88",
    "scrollbarSlider.activeBackground": "#72C7E6AA",
    "gitDecoration.addedResourceForeground": "#74E0B4",
    "gitDecoration.modifiedResourceForeground": "#7EBBFF",
    "gitDecoration.deletedResourceForeground": "#FF789E",
    "gitDecoration.untrackedResourceForeground": "#B3A0FF",
    "gitDecoration.ignoredResourceForeground": "#536682",
    "diffEditor.insertedTextBackground": "#2A806033",
    "diffEditor.removedTextBackground": "#A83E5B44",
    "notifications.background": "#101F34",
    "notifications.foreground": "#DCE8FF",
    "notifications.border": "#2B486C",
    "badge.background": "#1C9ABF",
    "badge.foreground": "#061321",
    "progressBar.background": "#69DFFF",
    "walkThrough.embeddedEditorBackground": "#0A1729"
  },
  "semanticTokenColors": {
    "namespace": "#8FC6FF",
    "class": "#81E3FF",
    "interface": "#9DE7D5",
    "type": "#8CE3E6",
    "typeParameter": "#C5B5FF",
    "enum": "#9DE7D5",
    "enumMember": "#F5C98B",
    "function": "#9DBBFF",
    "method": "#9DBBFF",
    "parameter": "#E3D5FF",
    "variable": "#DCE8FF",
    "property": "#8FC9DB",
    "property.readonly": "#B4C8F3",
    "keyword": "#D1A7FF",
    "modifier": "#B6A2FF",
    "comment": {
      "foreground": "#7187A7",
      "italic": true
    },
    "string": "#A7E6BC",
    "number": "#FFC889",
    "regexp": "#FFB1D0",
    "operator": "#7FDDF2",
    "decorator": "#FFB6DF",
    "macro": "#C7A8FF",
    "label": "#7DDDE0"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7187A7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D1A7FF"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control.flow",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#C59BFF"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A7E6BC"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#FFC889"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#9DBBFF"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#81E3FF"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#DCE8FF"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#8FC9DB"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#7FDDF2"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7BDDF3"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BBA8FF"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#81E3FF"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#8FC9DB"
      }
    },
    {
      "name": "PHP variables",
      "scope": [
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#82CEFF"
      }
    },
    {
      "name": "PHP tags",
      "scope": [
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php"
      ],
      "settings": {
        "foreground": "#FFB6DF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#81E3FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9DBBFF",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff additions",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8CE4B9"
      }
    },
    {
      "name": "Diff removals",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF8DAE"
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#C92F5B"
      }
    }
  ]
}