# .env.example - Environment Template for Ansh Singh Portfolio
# NOTE: Never store private secrets or API keys in client-side VITE_* variables.

# Optional: Server-side API endpoint for AI assistant or backend integrations
# VITE_API_ENDPOINT=https://api.example.com

# Server-Side Configuration (Keep in your server environment / serverless functions, NEVER in React client code)
# AI_API_KEY=YOUR_SERVER_SIDE_AI_KEY
